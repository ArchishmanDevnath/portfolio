---
import { site } from "../config/site";
---


<section class="mx-auto flex flex-1 items-center justify-center px-6">
  <div class="max-w-3xl text-center">

    <p class="mb-5 text-sm font-medium uppercase tracking-[0.35em] text-gray-500">
      {site.role}
    </p>

    <h1 class="text-5xl font-bold tracking-tight md:text-7xl">
      {site.tagline}
    </h1>

    <p class="mx-auto mt-8 max-w-2xl text-lg leading-8 text-gray-600">
      {site.description}
    </p>

    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href={site.links.projects}
        class="rounded-lg bg-black px-6 py-3 font-medium text-white transition hover:bg-gray-800"
      >
        View Projects
      </a>

      <a
        href={site.links.resume}
        class="rounded-lg border border-gray-300 px-6 py-3 font-medium transition hover:bg-gray-100"
      >
        Download Resume
      </a>
    </div>

  </div>
</section>