---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import { site } from "../config/site";
---

<BaseLayout
  title={`Resume | ${site.name}`}
  description={`Resume for ${site.name}.`}
>
  <Navbar />

  <main class="page-main">
    <section class="section page-section">
      <div class="reading-container content-panel">
        <p class="eyebrow">Resume</p>
        <h1 class="heading-1 page-heading">Resume coming soon</h1>

        <!-- TODO: Add the approved resume PDF to public/ and link or embed it here. -->
        <p class="text-secondary page-copy">
          A downloadable resume will be available here shortly.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-heading { margin-top: var(--space-3); }
  .page-copy { margin-top: var(--space-5); }
</style>
