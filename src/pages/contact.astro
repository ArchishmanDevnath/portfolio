---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import { site } from "../config/site";
---

<BaseLayout
  title={`Contact | ${site.name}`}
  description={`Contact ${site.name}.`}
>
  <Navbar />

  <main class="page-main">
    <section class="section page-section">
      <div class="content-container content-panel contact-panel">
        <div class="contact-grid">
          <div>
            <p class="eyebrow">Contact</p>
            <h1 class="heading-1 page-heading">Get in touch</h1>
            <p class="text-secondary page-copy">Contact details are listed below.</p>
          </div>

          <address class="contact-details">
            <ul class="contact-list" role="list">
              <li class="contact-method">
              <span class="metadata">Email</span>
              <a class="text-link contact-link" href={`mailto:${site.links.email}`}>{site.links.email}</a>
              </li>
              <li class="contact-method">
              <span class="metadata">LinkedIn</span>
              <a class="text-link contact-link" href={site.links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
              </li>
              <li class="contact-method">
              <span class="metadata">GitHub</span>
              <a class="text-link contact-link" href={site.links.github} target="_blank" rel="noreferrer">GitHub</a>
              </li>
            </ul>
          </address>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-heading { margin-top: var(--space-3); }
  .page-copy { margin-top: var(--space-5); }
  .contact-grid { display: grid; gap: var(--space-7); }
  .contact-details { font-style: normal; }
  .contact-list { border-top: 1px solid var(--color-border); }
  .contact-method { display: grid; gap: var(--space-2); padding-block: var(--space-5); border-bottom: 1px solid var(--color-border); }
  .contact-link { width: fit-content; }

  @media (min-width: 48rem) {
    .contact-grid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: start; gap: var(--space-8); }
  }
</style>
