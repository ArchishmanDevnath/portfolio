---
import { getCollection } from "astro:content";
import Footer from "../../components/Footer.astro";
import Navbar from "../../components/Navbar.astro";
import { site } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = await getCollection("projects");
const hasMultipleProjects = projects.length > 1;
---

<BaseLayout
  title={`Projects | ${site.name}`}
  description={`Projects by ${site.name}.`}
>
  <Navbar />

  <main class:list={["flex-1", { "page-main": !hasMultipleProjects }]}>
    <section class:list={["section", { "page-section": !hasMultipleProjects }]}>
      <div class:list={[hasMultipleProjects ? "content-container" : "reading-container", "content-panel"]}>
        <header class="projects-header">
          <p class="eyebrow">Projects</p>
          <h1 class="heading-1 page-heading">Projects</h1>
        </header>

        <div class:list={["project-list", { "has-multiple": hasMultipleProjects }]}>
          {projects.map((project) => (
            <article class="project-card">
              <div class="project-card-header">
                {project.data.status === "placeholder" && <span class="metadata">Placeholder</span>}
                <h2 class="heading-3">
                  <a class="text-link project-title-link" href={`/projects/${project.id}`}>{project.data.title}</a>
                </h2>
              </div>

              <p class="text-secondary project-summary">{project.data.summary}</p>

              {project.data.tags && project.data.tags.length > 0 && (
                <ul class="project-tags" role="list">
                  {project.data.tags.map((tag) => <li class="metadata">{tag}</li>)}
                </ul>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-heading { margin-top: var(--space-3); }
  .project-list { display: grid; gap: var(--space-4); margin-top: var(--space-6); }
  .project-card { display: grid; gap: var(--space-4); padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-md); background-color: var(--color-surface-muted); }
  .project-card-header { display: grid; gap: var(--space-2); }
  .project-title-link { text-decoration-thickness: 1px; }
  .project-summary { margin: 0; }
  .project-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }

  @media (min-width: 48rem) {
    .project-list.has-multiple { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 39.999rem) {
    .project-card { gap: var(--space-3); padding: var(--space-4); }
  }
</style>
