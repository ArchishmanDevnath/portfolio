---
import { site } from "../config/site";
---


<section class="section hero hero-section flex flex-1 items-center">
  <div class="content-container text-center">

    <p class="eyebrow hero-eyebrow">
      {site.role}
    </p>

    <div class="reading-container hero-copy">
      <h1 class="display-heading hero-heading">
        {site.tagline}
      </h1>

      <p class="hero-description text-secondary">
        {site.description}
      </p>
    </div>

    <div class="hero-actions flex flex-col items-center justify-center">
      <a
        href={site.links.projects}
        class="button button-primary"
      >
        View Projects
      </a>

      <a
        href={site.links.resume}
        class="button button-secondary"
      >
        Download Resume
      </a>
    </div>

  </div>
</section>

<style>
  .hero-eyebrow { margin-bottom: var(--space-5); }
  .hero-section { padding-block: clamp(var(--space-6), 6vw, var(--space-8)); }
  .hero-copy { margin-inline: auto; }
  .hero-description { margin-top: var(--space-6); font-size: var(--text-body); line-height: var(--leading-body); }
  .hero-actions { gap: var(--space-3); margin-top: var(--space-7); }

  @media (min-width: 40rem) {
    .hero-actions { flex-direction: row; }
  }

  @media (max-width: 39.999rem) {
    .hero-section { padding-block: var(--space-5) var(--space-7); }
    .hero-eyebrow { margin-bottom: var(--space-4); }
    .hero-heading { font-size: clamp(2.25rem, 10vw, 3.25rem); overflow-wrap: anywhere; text-wrap: balance; }
    .hero-description { margin-top: var(--space-5); }
    .hero-actions { width: min(100%, 20rem); margin-inline: auto; margin-top: var(--space-6); }
    .hero-actions .button { width: 100%; }
  }
</style>
