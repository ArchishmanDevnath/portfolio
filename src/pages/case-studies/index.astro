---
import { getCollection } from "astro:content";
import Footer from "../../components/Footer.astro";
import Navbar from "../../components/Navbar.astro";
import { site } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

const caseStudies = await getCollection("caseStudies");
const hasMultipleCaseStudies = caseStudies.length > 1;
---

<BaseLayout
  title={`Case Studies | ${site.name}`}
  description={`Case studies by ${site.name}.`}
>
  <Navbar />

  <main class:list={["flex-1", { "page-main": !hasMultipleCaseStudies }]}>
    <section class:list={["section", { "page-section": !hasMultipleCaseStudies }]}>
      <div class:list={[hasMultipleCaseStudies ? "content-container" : "reading-container", "content-panel"]}>
        <header>
          <p class="eyebrow">Case Studies</p>
          <h1 class="heading-1 page-heading">Case Studies</h1>
        </header>

        <div class:list={["case-study-list", { "has-multiple": hasMultipleCaseStudies }]}>
          {caseStudies.map((caseStudy) => (
            <article class="case-study-card">
              <div class="case-study-card-header">
                {caseStudy.data.status === "placeholder" && <span class="metadata">Placeholder</span>}
                <h2 class="heading-3">
                  <a class="text-link case-study-title-link" href={`/case-studies/${caseStudy.id}`}>{caseStudy.data.title}</a>
                </h2>
              </div>

              <p class="text-secondary case-study-summary">{caseStudy.data.summary}</p>

              {caseStudy.data.tags && caseStudy.data.tags.length > 0 && (
                <ul class="case-study-tags" role="list">
                  {caseStudy.data.tags.map((tag) => <li class="metadata">{tag}</li>)}
                </ul>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-heading { margin-top: var(--space-3); }
  .case-study-list { display: grid; gap: var(--space-4); margin-top: var(--space-6); }
  .case-study-card { display: grid; gap: var(--space-4); padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-md); background-color: var(--color-surface-muted); }
  .case-study-card-header { display: grid; gap: var(--space-2); }
  .case-study-title-link { text-decoration-thickness: 1px; }
  .case-study-summary { margin: 0; }
  .case-study-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }

  @media (min-width: 48rem) {
    .case-study-list.has-multiple { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
