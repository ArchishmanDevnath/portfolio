---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Archishman Devnath | Portfolio",
  description = "Aspiring Product Manager documenting product case studies, experiments, and insights.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-white text-gray-900 flex flex-col">
    <slot />
  </body>
</html>